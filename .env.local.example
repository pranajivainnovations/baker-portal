# CrossFriend Baker Portal — baker.crossfriend.in
#
# This app reads exactly ONE variable. There is deliberately no DATABASE_URL and no signing secret:
# the portal cannot verify a session, cannot read the database, and cannot decide what a baker owns.
# It holds an opaque token issued by the backend and forwards it; every authorization question is
# answered by the backend on every request.
#
# If you find yourself wanting credentials here, the logic you're writing belongs in the backend.

# Where to reach the CrossFriend backend. Server-to-server — this is called from the Next server,
# never from the browser, so it does not need to be publicly resolvable.
MEDUSA_BACKEND_URL=http://localhost:9000
