# CrossFriend Baker Portal — baker.crossfriend.in
#
# This app deliberately has NO database credentials. It talks only to the CrossFriend backend,
# which owns baker identity and authorization. If you find yourself wanting DATABASE_URL here,
# the logic you are writing belongs in the backend instead.

# The CrossFriend / Medusa backend.
MEDUSA_BACKEND_URL=http://localhost:9000

# Public base URL of this portal — used to build activation links shown in OPS.
NEXT_PUBLIC_PORTAL_URL=http://localhost:5000
